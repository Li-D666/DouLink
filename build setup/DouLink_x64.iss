; Script generated by the Inno Setup Script Wizard.
; SEE THE DOCUMENTATION FOR DETAILS ON CREATING INNO SETUP SCRIPT FILES!
; Non-commercial use only

#define MyAppName "DouLink"
#define MyAppVersion "1.0.1"
#define MyAppPublisher "Li, Inc."
#define MyAppURL ""
#define MyAppExeName "DouLink.exe"
#define MyAppAssocName MyAppName + " File"
#define MyAppAssocExt ".myp"
#define MyAppAssocKey StringChange(MyAppAssocName, " ", "") + MyAppAssocExt
#define MyAppBaseDir "..\build\Release"
#define SetupBuildTime GetDateTimeString('yyyymmddhh', '-')
#define MyAppId "B4D3FABC-EF7A-4FA4-B884-47C2F5039A26"

#define VsPath "C:\Program Files\Microsoft Visual Studio\2022\Community\Common7\IDE"

[Setup]
; NOTE: The value of AppId uniquely identifies this application. Do not use the same AppId value in installers for other applications.
; (To generate a new GUID, click Tools | Generate GUID inside the IDE.)
AppId={{{#MyAppId}}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
;AppVerName={#MyAppName} {#MyAppVersion}
AppPublisher={#MyAppPublisher}
AppPublisherURL={#MyAppURL}
AppSupportURL={#MyAppURL}
AppUpdatesURL={#MyAppURL}
DefaultDirName={autopf}\{#MyAppName}
UninstallDisplayIcon={app}\{#MyAppExeName}
; "ArchitecturesAllowed=x64compatible" specifies that Setup cannot run
; on anything but x64 and Windows 11 on Arm.
ArchitecturesAllowed=x64compatible
; "ArchitecturesInstallIn64BitMode=x64compatible" requests that the
; install be done in "64-bit mode" on x64 or Windows 11 on Arm,
; meaning it should use the native 64-bit Program Files directory and
; the 64-bit view of the registry.
ArchitecturesInstallIn64BitMode=x64compatible
ChangesAssociations=yes
DisableProgramGroupPage=yes
; Uncomment the following line to run in non administrative install mode (install for current user only).
;PrivilegesRequired=lowest
OutputBaseFilename={#MyAppName}_V{#MyAppVersion}_Setup
SolidCompression=yes
WizardStyle=modern
; 自动使用上次安装的目录

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl,CustomMessage.isl"
Name: "chinese"; MessagesFile: "compiler:Languages\Chinese.isl,CustomMessage.isl"

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: checkablealone

[Files]
Source: "{#MyAppBaseDir}\{#MyAppExeName}"; DestDir: "{app}"; Flags: ignoreversion
;Qt库
Source: "{#MyAppBaseDir}\bearer\*"; DestDir: "{app}\QtPlugins\bearer"; Flags: ignoreversion recursesubdirs createallsubdirs
Source: "{#MyAppBaseDir}\iconengines\*"; DestDir: "{app}\QtPlugins\iconengines"; Flags: ignoreversion recursesubdirs createallsubdirs
Source: "{#MyAppBaseDir}\imageformats\*"; DestDir: "{app}\QtPlugins\imageformats"; Flags: ignoreversion recursesubdirs createallsubdirs
Source: "{#MyAppBaseDir}\platforms\*"; DestDir: "{app}\QtPlugins\platforms"; Flags: ignoreversion recursesubdirs createallsubdirs
Source: "{#MyAppBaseDir}\styles\*"; DestDir: "{app}\QtPlugins\styles"; Flags: ignoreversion recursesubdirs createallsubdirs
Source: "{#MyAppBaseDir}\translations\*"; DestDir: "{app}\QtPlugins\translations"; Flags: ignoreversion recursesubdirs createallsubdirs
Source: "{#MyAppBaseDir}\Qt5Core.dll"; DestDir: "{app}"; Flags: ignoreversion
Source: "{#MyAppBaseDir}\Qt5Gui.dll"; DestDir: "{app}"; Flags: ignoreversion
Source: "{#MyAppBaseDir}\Qt5Network.dll"; DestDir: "{app}"; Flags: ignoreversion
Source: "{#MyAppBaseDir}\Qt5SerialPort.dll"; DestDir: "{app}"; Flags: ignoreversion
Source: "{#MyAppBaseDir}\Qt5Widgets.dll"; DestDir: "{app}"; Flags: ignoreversion
Source: ".\qt.conf"; DestDir: "{app}"; Flags: ignoreversion
;翻译文件
;VS运行库
Source: "{#VsPATH}\vcruntime140.dll"; DestDir: "{app}"; Flags: ignoreversion
Source: "{#VsPATH}\vcruntime140_1.dll"; DestDir: "{app}"; Flags: ignoreversion
Source: "{#VsPATH}\msvcp140.dll"; DestDir: "{app}"; Flags: ignoreversion
Source: "{#VsPATH}\msvcp140_1.dll"; DestDir: "{app}"; Flags: ignoreversion
Source: "{#VsPATH}\concrt140.dll"; DestDir: "{app}"; Flags: ignoreversion
;MinGW库   libgcc_s_seh-1,libstdc++-6,libwinpthread-1
;Source: "{#MyAppBaseDir}\libgcc_s_seh-1.dll"; DestDir: "{app}"; Flags: ignoreversion
;Source: "{#MyAppBaseDir}\libstdc++-6.dll"; DestDir: "{app}"; Flags: ignoreversion
;Source: "{#MyAppBaseDir}\libwinpthread-1.dll"; DestDir: "{app}"; Flags: ignoreversion
; 三方库
; 附加文件
; NOTE: Don't use "Flags: ignoreversion" on any shared system files

[Registry]
Root: HKA; Subkey: "Software\Classes\{#MyAppAssocExt}\OpenWithProgids"; ValueType: string; ValueName: "{#MyAppAssocKey}"; ValueData: ""; Flags: uninsdeletevalue
Root: HKA; Subkey: "Software\Classes\{#MyAppAssocKey}"; ValueType: string; ValueName: ""; ValueData: "{#MyAppAssocName}"; Flags: uninsdeletekey
Root: HKA; Subkey: "Software\Classes\{#MyAppAssocKey}\DefaultIcon"; ValueType: string; ValueName: ""; ValueData: "{app}\{#MyAppExeName},0"
Root: HKA; Subkey: "Software\Classes\{#MyAppAssocKey}\shell\open\command"; ValueType: string; ValueName: ""; ValueData: """{app}\{#MyAppExeName}"" ""%1"""

[Icons]
Name: "{autoprograms}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"
Name: "{autodesktop}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; Tasks: desktopicon

[Run]
Filename: "{app}\{#MyAppExeName}"; Description: "{cm:LaunchProgram,{#StringChange(MyAppName, '&', '&&')}}"; Flags: nowait postinstall skipifsilent unchecked

[Code]
procedure CurStepChanged(CurStep: TSetupStep);
var
  UninstallKey: String;
  UninstallString: String;
  ResultCode: Integer;
  UserChoice: Integer;
begin
  if CurStep=ssInstall then
  begin
    UninstallKey := 'SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\{{#MyAppId}}_is1';
    // 检查是否存在旧版本
    if RegQueryStringValue(HKLM, UninstallKey, 'UninstallString', UninstallString) then
    begin
      // 弹窗询问用户
      UserChoice := MsgBox(CustomMessage('UninstallPrompt'), mbConfirmation, MB_YESNO);
      
      if UserChoice = IDYES then
      begin
        // 用户选择“是”，卸载旧版本
        UninstallString := RemoveQuotes(UninstallString);
        Exec(UninstallString, '/silent /suppressmsgboxes /norestart', '', SW_HIDE, ewWaitUntilTerminated, ResultCode);
      end
      else
      begin
        // 用户选择“否”，退出安装
        Exit;
      end;
    end;
  end;
end;


