/* DouLink light console theme */

QWidget {
    color: #243447;
    font-family: "Microsoft YaHei UI";
    font-size: 13px;
}

QMainWindow,
QDialog {
    background: #eef2f7;
}

QWidget#centralwidget {
    background: #eef2f7;
}

QWidget#rightPane,
QWidget#sessionPage,
QWidget#emptyPage {
    background: transparent;
}

QFrame#appHeader {
    background: #ffffff;
    border-bottom: 1px solid #b3c5d4;
}

QLabel[role="brandTitle"] {
    color: #172b3c;
    font-size: 20px;
    font-weight: 700;
}

QLabel[role="brandSubtitle"] {
    color: #5c6f82;
    font-size: 11px;
}

QFrame#sidePanel {
    background: #f8fafc;
    border-right: 1px solid #b3c5d4;
}

QLabel[role="panelTitle"] {
    color: #26394c;
    font-size: 14px;
    font-weight: 600;
}

QLabel[role="countPill"] {
    background: #e9eff5;
    border: 1px solid #a2b6c8;
    border-radius: 9px;
    color: #52677a;
    font-size: 11px;
    padding: 2px 8px;
}

QListWidget#sessionList {
    background: transparent;
    border: none;
    outline: none;
}

QListWidget#sessionList::item {
    background: transparent;
    border: none;
    padding: 0;
}

QListWidget#sessionList::item:selected,
QListWidget#sessionList::item:hover {
    background: transparent;
}

QPushButton {
    background: #ffffff;
    border: 1px solid #a2b6c8;
    border-radius: 7px;
    padding: 7px 14px;
    color: #34495e;
}

QPushButton:hover {
    background: #e8f1f6;
    border-color: #8fb6c5;
}

QPushButton:pressed {
    background: #dce9f0;
}

QPushButton:disabled {
    background: #e9edf1;
    border-color: #b3c5d4;
    color: #6f8396;
}

QPushButton[role="primary"] {
    background: #0e7490;
    border: 1px solid #0e7490;
    color: #ffffff;
    font-weight: 700;
}

QPushButton[role="primary"]:hover {
    background: #0b7285;
    border-color: #0b7285;
}

QPushButton[role="primary"]:pressed {
    background: #155e75;
}

QPushButton[role="primary"]:disabled {
    background: #d7e9ee;
    border-color: #c3dce3;
    color: #6f8b95;
}

QPushButton[role="ghost"] {
    background: transparent;
    border-color: #a2b6c8;
    color: #52677a;
}

QPushButton[role="ghost"]:hover {
    background: #e8f2f6;
    border-color: #8fb6c5;
    color: #263e52;
}

QPushButton[role="secondary"] {
    background: #e3f3f8;
    border: 1px solid #8fc9d8;
    color: #0b7285;
    font-weight: 600;
}

QPushButton[role="secondary"]:hover {
    background: #d6edf5;
    border-color: #0b7285;
}

QPushButton[role="small"] {
    background: #f4f7fa;
    border: 1px solid #a2b6c8;
    border-radius: 6px;
    padding: 5px 9px;
    font-size: 12px;
    color: #52677a;
}

QPushButton[role="small"]:hover {
    border-color: #8fb6c5;
    color: #263e52;
}

QPushButton[role="small"]:checked {
    background: #d9eef4;
    border-color: #0b7285;
    color: #0b7285;
}

QPushButton[role="icon"] {
    padding: 0;
    min-height: 0;
    border-radius: 16px;
    border: 1px solid #a2b6c8;
    background: transparent;
    color: #52677a;
    font-weight: 700;
}

QPushButton[role="icon"]:hover {
    color: #0b7285;
    border-color: #0b7285;
}

QPushButton[role="launch"] {
    text-align: center;
    background: #ffffff;
    border: 1px solid #a2b6c8;
    border-radius: 12px;
    padding: 12px;
    color: #34495e;
    font-size: 14px;
    font-weight: 600;
}

QPushButton[role="launch"]:hover {
    background: #eaf6fa;
    border-color: #0b7285;
    color: #0b7285;
}

QLabel {
    background: transparent;
}

QLabel[role="hint"] {
    color: #5c6f82;
    font-size: 12px;
}

QLabel[role="muted"] {
    color: #5c6f82;
    font-size: 12px;
}

QLabel[role="sessionTitle"] {
    color: #1c3043;
    font-size: 19px;
    font-weight: 700;
}

QLabel[role="cardTitle"] {
    color: #2c4054;
    font-size: 14px;
    font-weight: 600;
}

QLabel[role="statChip"] {
    background: #eef3f7;
    border: 1px solid #a2b6c8;
    border-radius: 6px;
    padding: 4px 9px;
    color: #52677a;
    font-size: 11px;
}

QLabel[role="statChip"][direction="rx"] {
    color: #166534;
}

QLabel[role="statChip"][direction="tx"] {
    color: #0369a1;
}

QLabel[role="stateBadge"] {
    border-radius: 10px;
    padding: 3px 10px;
    font-size: 11px;
    font-weight: 600;
}

QLabel[role="stateBadge"][state="offline"] {
    background: #eef2f6;
    border: 1px solid #a2b6c8;
    color: #5c6f82;
}

QLabel[role="stateBadge"][state="connecting"] {
    background: #fef3c7;
    border: 1px solid #f0c96b;
    color: #92400e;
}

QLabel[role="stateBadge"][state="online"] {
    background: #e9f8ef;
    border: 1px solid #a7d7b5;
    color: #166534;
}

QLabel[role="stateBadge"][state="error"] {
    background: #fdecec;
    border: 1px solid #efb4b4;
    color: #b91c1c;
}

QLabel[role="emptyTitle"] {
    color: #1c3043;
    font-size: 26px;
    font-weight: 700;
}

QLabel[role="dialogTitle"] {
    color: #1c3043;
    font-size: 22px;
    font-weight: 700;
}

QLabel[role="error"] {
    color: #b91c1c;
    font-size: 12px;
}

QLabel[role="field"] {
    color: #52677a;
    font-size: 12px;
}

QLineEdit,
QComboBox,
QSpinBox {
    background: #ffffff;
    border: 1px solid #a2b6c8;
    border-radius: 6px;
    padding: 6px 9px;
    color: #34495e;
    selection-background-color: #0b7285;
    selection-color: #ffffff;
    min-height: 18px;
}

QLineEdit:hover,
QComboBox:hover,
QSpinBox:hover {
    border-color: #8fb6c5;
}

QLineEdit:focus,
QComboBox:focus,
QSpinBox:focus {
    border-color: #0b7285;
}

QLineEdit:disabled,
QComboBox:disabled,
QSpinBox:disabled {
    color: #6f8396;
    background: #f0f3f6;
}

QComboBox::drop-down {
    border: none;
    width: 20px;
}

QComboBox QAbstractItemView {
    background: #ffffff;
    border: 1px solid #a2b6c8;
    border-radius: 4px;
    padding: 4px;
    selection-background-color: #d9eef4;
    selection-color: #0b7285;
    outline: none;
}

QSpinBox {
    padding-right: 20px;
}

QPlainTextEdit#logView {
    background: #f8fafc;
    border: 1px solid #a2b6c8;
    border-radius: 8px;
    padding: 8px;
    font-family: "Consolas";
    font-size: 13px;
    color: #34495e;
    selection-background-color: #b9dde8;
    selection-color: #12343f;
}

QPlainTextEdit#input {
    background: #ffffff;
    border: 1px solid #a2b6c8;
    border-radius: 8px;
    padding: 8px;
    font-family: "Consolas";
    font-size: 13px;
    color: #34495e;
    selection-background-color: #b9dde8;
    selection-color: #12343f;
}

QPlainTextEdit#input:focus {
    border-color: #0b7285;
}

QFrame[role="card"] {
    background: #ffffff;
    border: 1px solid #a2b6c8;
    border-radius: 10px;
}

QGroupBox {
    background: #ffffff;
    border: 1px solid #a2b6c8;
    border-radius: 9px;
    margin-top: 10px;
    padding: 16px 12px 10px 12px;
    color: #34495e;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    padding: 0 6px;
    color: #0b7285;
}

QCheckBox {
    spacing: 6px;
    color: #52677a;
    font-size: 12px;
}

QCheckBox:hover {
    color: #263e52;
}

QToolButton[role="segment"] {
    background: #ffffff;
    border: 1px solid #a2b6c8;
    border-radius: 6px;
    padding: 5px 11px;
    color: #5c6f82;
    font-size: 12px;
}

QToolButton[role="segment"]:hover {
    border-color: #8fb6c5;
    color: #34495e;
}

QToolButton[role="segment"]:checked {
    background: #d9eef4;
    border-color: #0b7285;
    color: #0b7285;
    font-weight: 600;
}

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background: #b6c6d6;
    min-height: 28px;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background: #94acbf;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: transparent;
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 2px;
}

QScrollBar::handle:horizontal {
    background: #b6c6d6;
    min-width: 28px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal:hover {
    background: #94acbf;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
}

QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: transparent;
}

QSplitter::handle {
    background: #b3c5d4;
}

QSplitter::handle:hover {
    background: #0e7490;
}

QMenu {
    background: #ffffff;
    border: 1px solid #a2b6c8;
    border-radius: 6px;
    padding: 6px;
}

QMenu::item {
    padding: 7px 24px 7px 12px;
    border-radius: 4px;
    color: #34495e;
}

QMenu::item:selected {
    background: #d9eef4;
    color: #0b7285;
}

QMenu::separator {
    height: 1px;
    background: #b3c5d4;
    margin: 5px 8px;
}

QFrame#statusFooter {
    background: #ffffff;
    border-top: 1px solid #b3c5d4;
}

QLabel[role="statusText"] {
    color: #5c6f82;
    font-size: 11px;
    padding-left: 8px;
}

QLabel[role="statusToast"] {
    color: #0b7285;
    font-size: 11px;
    padding-left: 8px;
}

QLabel#meta[state="error"] {
    color: #b91c1c;
}

QToolTip {
    background: #ffffff;
    color: #34495e;
    border: 1px solid #a2b6c8;
    padding: 5px;
}